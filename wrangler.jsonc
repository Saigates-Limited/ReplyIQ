{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "replyiq",
  "main": "dist/index.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],

  // Static files in public/ (served at /static/* via the ASSETS binding)
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Gmail poller: every 15 minutes, read-only. Email is only ever sent by a staff member pressing Send.
  "triggers": { "crons": ["*/15 * * * *"] },

  // Cloudflare Hyperdrive → Supabase session pooler (5432). Direct Worker→Supavisor TLS does not complete.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "619303c46e164a8eab43ef1101c16470",
      "localConnectionString": "postgres://replyiq:replyiq_dev@localhost:5432/replyiq"
    }
  ],

  "observability": { "enabled": true }

  // Secrets (wrangler secret put <NAME>): OPENAI_API_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TOKEN_ENC_KEY
}
