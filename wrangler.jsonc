{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"]
  // Secrets (never put values here):
  //   DATABASE_URL     - Supabase Transaction Pooler URI (port 6543, ?sslmode=require)
  //   OPENAI_API_KEY   - OpenAI key, server-side only
  // Set them in the Cloudflare Pages dashboard (Settings → Environment variables, type "Secret")
  // or with: npx wrangler pages secret put DATABASE_URL --project-name <project>
}
