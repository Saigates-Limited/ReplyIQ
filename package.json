{
  "name": "replyiq",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler dev --ip 0.0.0.0 --port 3000 --test-scheduled",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f db/seed.sql",
    "db:reset": "npm run db:schema && npm run db:seed",
    "test": "curl -s http://localhost:3000/api/health"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
